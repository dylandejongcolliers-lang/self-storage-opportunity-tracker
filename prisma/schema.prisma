// Prisma schema — the single source of truth for the database shape.
// After editing this file, run:  npx prisma migrate dev --name <change>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection, used by the app
  directUrl = env("DIRECT_URL")     // direct connection, used for migrations
}

/// Where a listing sits in our pipeline.
enum Stage {
  New
  TeamReviewed
  UnderwritingOffer
}

/// Who on our side owns the listing.
enum AssignedTo {
  Dylan
  Tom
}

/// Status of a listing<->client match within the current publishing week.
enum WeekStatus {
  New
  CarriedOver
  Updated
  Passed
}

/// The team's own call on a listing while working through opportunities —
/// separate from Stage (pipeline) and from any client's reaction. Null = not
/// reviewed yet. Interested = green, Reviewing = yellow, Discarded = red.
enum ReviewStatus {
  Interested
  Reviewing
  Discarded
}

/// A client's own read on a listing, left from their share page. Green/
/// Yellow/Red in the UI.
enum ClientReaction {
  ReviewFurther
  Maybe
  NotInterested
}

/// A geographic market, managed at runtime from the "Manage Markets" page.
model Market {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  /// Broad tier, e.g. "West Coast", "Southwest", "National". Free text.
  region    String   @default("")
  /// USPS state codes this market covers, e.g. ["CA", "NV"]. Used to
  /// auto-assign a market when a listing has a state but no market.
  states    String[]
  color     String   @default("#64748b")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  Listing[]

  @@index([active])
}

/// A single self-storage sale opportunity.
model Listing {
  id            String      @id @default(cuid())
  propertyName  String
  address       String      @default("")
  city          String?
  state         String?     // USPS code
  marketId      String?
  market        Market?     @relation(fields: [marketId], references: [id], onDelete: SetNull)
  source        String      @default("")
  dateFirstSeen DateTime    @default(now())
  stage         Stage       @default(New)

  askingPrice   Int?        // whole US dollars
  unitCount     Int?
  nrsf          Int?        // net rentable square feet
  capRate       Float?      // percent, e.g. 6.25

  listingLink   String?
  dealRoomLink  String?
  brokerContact String?
  assignedTo    AssignedTo?
  internalNotes String      @default("")

  /// Set by the ingestion API for lower-confidence intake so it can be triaged
  /// in the Review queue instead of blending into the main list.
  flaggedForReview Boolean  @default(false)
  flagReason       String   @default("")

  /// Team review status (null = not reviewed), an optional free-text reason,
  /// and when the status was last set.
  reviewStatus     ReviewStatus?
  reviewReason     String   @default("")
  reviewedAt       DateTime?

  createdAt     DateTime    @default(now())
  lastUpdated   DateTime    @updatedAt

  matches       ListingClientMatch[]
  boardLinks    ClientBoardListing[]

  @@index([marketId])
  @@index([stage])
  @@index([flaggedForReview])
  @@index([reviewStatus])
}

/// A buyer we send matched opportunities to.
model Client {
  id                String   @id @default(cuid())
  name              String
  /// Unguessable token in the client-facing URL: /share/<shareToken>
  shareToken        String   @unique

  /// Market slugs this client is interested in (loose reference to Market.slug).
  buyBoxMarkets     String[]
  buyBoxPriceMin    Int?
  buyBoxPriceMax    Int?
  buyBoxCapRateMin  Float?
  buyBoxUnitMin     Int?
  buyBoxUnitMax     Int?
  buyBoxNotes       String   @default("")

  /// When the weekly snapshot was last published for this client.
  lastPublishedAt   DateTime?

  createdAt         DateTime @default(now())
  lastUpdated       DateTime @updatedAt

  matches           ListingClientMatch[]
  boards            ClientBoard[]
}

/// A client-labeled board for organizing listings. Deliberately separate from
/// Client / buy-box data — `clientId` is an optional loose link, not a merge.
model ClientBoard {
  id        String   @id @default(cuid())
  name      String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  ClientBoardListing[]

  @@index([clientId])
}

/// Many-to-many join: a listing can sit on many boards without being copied.
model ClientBoardListing {
  id        String      @id @default(cuid())
  boardId   String
  listingId String
  board     ClientBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addedNote String      @default("")
  addedAt   DateTime    @default(now())

  @@unique([boardId, listingId])
  @@index([listingId])
}

/// A confirmed pairing of one listing with one client.
model ListingClientMatch {
  id                String     @id @default(cuid())
  listingId         String
  clientId          String
  listing           Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  client            Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  clientFacingNotes String     @default("")
  weekStatus        WeekStatus @default(New)

  /// The client's own reaction, left from their share page. Null = not
  /// reviewed yet.
  clientReaction    ClientReaction?
  clientReactionAt  DateTime?

  matchedAt         DateTime   @default(now())
  lastUpdated       DateTime   @updatedAt

  @@unique([listingId, clientId])
  @@index([clientId])
}
