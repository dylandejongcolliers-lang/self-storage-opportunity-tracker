# Copy to .env and fill in. .env is git-ignored.

# Neon Postgres — pooled connection string (hostname contains "-pooler").
# Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon Postgres — direct connection string (same as above without "-pooler").
# Used only by Prisma for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Shared password for the internal /dashboard pages.
APP_PASSWORD="choose-a-team-password"

# Random 40+ char string used to sign the login cookie.
AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""

# Bearer token for POST /api/ingest/listings
INGEST_API_TOKEN="generate-a-long-random-string"
